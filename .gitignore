/QuickSub/obj/
/QuickSub/Artifacts/
/QuickSub/TestResults/
/QuickSub/BenchmarkDotNet.Artifacts/
*.nupkg
*.snupkg

# Publish-profile user settings may contain local paths or credentials
*.pubxml.user

