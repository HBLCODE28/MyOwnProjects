{
  "name": "streamlocal-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Private local media library for Windows",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5174 && cross-env STREAMLOCAL_DEV_URL=http://127.0.0.1:5174 electron .\"",
    "build": "npm run build:main && vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.streamlocal.desktop",
    "productName": "StreamLocal",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "package.json"],
    "win": { "icon": "../tools/windows-packager/StreamLocal.ico", "target": [{ "target": "nsis", "arch": ["x64"] }], "artifactName": "StreamLocal-Setup.exe" },
    "nsis": { "oneClick": true, "perMachine": false, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "StreamLocal" }
  },
  "dependencies": { "@vitejs/plugin-react": "^5.0.0", "electron": "^37.2.0", "react": "^19.1.0", "react-dom": "^19.1.0", "vite": "^7.1.0" },
  "devDependencies": { "@types/node": "^24.3.0", "@types/react": "^19.1.0", "@types/react-dom": "^19.1.0", "concurrently": "^9.2.1", "cross-env": "^7.0.3", "electron-builder": "^26.0.12", "typescript": "^5.9.0", "vitest": "^3.2.4", "wait-on": "^8.0.3" }
}
