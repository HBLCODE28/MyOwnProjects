<Window x:Class="ClientApp.LogoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" 
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Width="300" Height="300" ShowInTaskbar="False">
    <Border Background="White" CornerRadius="20" Padding="20" BorderBrush="Gray" BorderThickness="1">
        <Image Source="images/logo.png" Stretch="Uniform"/>
    </Border>
</Window>
