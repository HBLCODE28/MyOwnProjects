<Window x:Class="QuickSub.Views.ExistingSubtitlesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Existing subtitles"
        Icon="/QuickSub;component/Assets/QuickSub.ico"
        Width="520"
        Height="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FlowDirection="LeftToRight"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Existing subtitles were found"
                       FontSize="23"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="DescriptionText"
                       Style="{StaticResource SecondaryText}"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0" />
        </StackPanel>

        <WrapPanel Grid.Row="1" HorizontalAlignment="Right">
            <Button Content="Keep all"
                    Style="{StaticResource SecondaryButton}"
                    Click="KeepAll_Click"
                    Margin="0,0,10,0" />
            <Button Content="Review individually"
                    Style="{StaticResource SecondaryButton}"
                    Click="Review_Click"
                    Margin="0,0,10,0" />
            <Button Content="Replace all" Click="ReplaceAll_Click" />
        </WrapPanel>
    </Grid>
</Window>
