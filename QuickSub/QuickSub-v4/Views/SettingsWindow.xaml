<Window x:Class="QuickSub.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickSub Settings"
        Icon="/QuickSub;component/Assets/QuickSub.ico"
        Width="610"
        Height="710"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FlowDirection="LeftToRight"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="26" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Settings" FontSize="27" FontWeight="SemiBold" />
            <TextBlock Text="OpenSubtitles credentials are encrypted for the current Windows user. The saved password and API key are never displayed."
                       Style="{StaticResource SecondaryText}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,22,0,22">
            <StackPanel>
                <TextBlock Text="OpenSubtitles username" Margin="0,0,0,6" />
                <TextBox x:Name="UsernameTextBox" />
                <TextBlock x:Name="UsernameHelpText"
                           Style="{StaticResource SecondaryText}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />

                <TextBlock Text="Password" Margin="0,15,0,6" />
                <PasswordBox x:Name="PasswordInput" />
                <TextBlock x:Name="PasswordHelpText"
                           Style="{StaticResource SecondaryText}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />

                <TextBlock Text="API key" Margin="0,15,0,6" />
                <PasswordBox x:Name="ApiKeyInput" />
                <TextBlock x:Name="ApiKeyHelpText"
                           Style="{StaticResource SecondaryText}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />

                <TextBlock Text="These buttons open OpenSubtitles.com in your default browser. Create the account first, sign in, and then open the API key page."
                           Style="{StaticResource SecondaryText}"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0" />

                <WrapPanel Margin="0,10,0,0">
                    <Button Content="Create account"
                            Style="{StaticResource SecondaryButton}"
                            Click="CreateAccount_Click"
                            Margin="0,0,10,8" />
                    <Button Content="Open API key page"
                            Style="{StaticResource SecondaryButton}"
                            Click="OpenApiKeyPage_Click"
                            Margin="0,0,10,8" />
                    <Button x:Name="TestConnectionButton"
                            Content="Test connection"
                            Style="{StaticResource SecondaryButton}"
                            Click="TestConnection_Click"
                            Margin="0,0,10,8" />
                </WrapPanel>

                <Separator Margin="0,18,0,18" Background="{DynamicResource BorderBrush}" />

                <TextBlock Text="Subtitle language" Margin="0,0,0,6" />
                <ComboBox x:Name="LanguageComboBox">
                    <ComboBoxItem Content="English" Tag="en" />
                    <ComboBoxItem Content="Hebrew" Tag="he" />
                </ComboBox>

                <TextBlock Text="Theme" Margin="0,15,0,6" />
                <ComboBox x:Name="ThemeComboBox">
                    <ComboBoxItem Content="Dark" Tag="Dark" />
                    <ComboBoxItem Content="Light" Tag="Light" />
                </ComboBox>

                <TextBlock Text="Hearing-impaired subtitles" Margin="0,15,0,6" />
                <ComboBox x:Name="HearingComboBox">
                    <ComboBoxItem Content="Prefer standard subtitles" Tag="PreferStandard" />
                    <ComboBoxItem Content="No preference" Tag="NoPreference" />
                    <ComboBoxItem Content="Use only when needed" Tag="AllowIfNeeded" />
                </ComboBox>

                <CheckBox x:Name="IncludeSpecialsCheckBox"
                          Content="Include specials (Season 0) when checking missing episodes"
                          Margin="0,16,0,0" />

                <TextBlock x:Name="ConnectionStatusText"
                           Style="{StaticResource SecondaryText}"
                           TextWrapping="Wrap"
                           Margin="0,16,0,0" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Style="{StaticResource SecondaryButton}"
                    Click="Cancel_Click"
                    Margin="0,0,10,0" />
            <Button Content="Save" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
