<Window x:Class="QuickSub.Views.MissingItemsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickSub details"
        Icon="/QuickSub;component/Assets/QuickSub.ico"
        Width="760"
        Height="620"
        WindowStartupLocation="CenterOwner"
        FlowDirection="LeftToRight"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Details" FontSize="25" FontWeight="SemiBold" />

        <TabControl Grid.Row="1" Margin="0,18,0,18">
            <TabItem Header="Missing subtitles">
                <ListBox x:Name="MissingSubtitlesList" />
            </TabItem>
            <TabItem Header="Missing video files">
                <ListBox x:Name="MissingVideosList" />
            </TabItem>
            <TabItem Header="Not aired yet">
                <ListBox x:Name="FutureEpisodesList" />
            </TabItem>
            <TabItem Header="Skipped names">
                <ListBox x:Name="SkippedFilesList" />
            </TabItem>
        </TabControl>

        <Button Grid.Row="2"
                Content="Close"
                HorizontalAlignment="Right"
                Style="{StaticResource SecondaryButton}"
                Click="Close_Click" />
    </Grid>
</Window>
