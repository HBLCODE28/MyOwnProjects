<Window x:Class="QuickSub.Views.ResultsReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review results"
        Icon="/QuickSub;component/Assets/QuickSub.ico"
        Width="760"
        Height="590"
        WindowStartupLocation="CenterOwner"
        FlowDirection="LeftToRight"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Review results" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Select a found episode and choose an alternative subtitle when needed."
                       Style="{StaticResource SecondaryText}"
                       Margin="0,5,0,0" />
        </StackPanel>

        <ListBox x:Name="ResultsListBox" Grid.Row="1" Margin="0,18,0,18">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="12,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="95" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding EpisodeCode}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding FileName}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="8,0" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Status}"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource SecondaryText}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2">
            <Button Content="Choose alternative"
                    Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Left"
                    Click="ChooseAlternative_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close"
                        Style="{StaticResource SecondaryButton}"
                        Click="Close_Click"
                        Margin="0,0,10,0" />
                <Button Content="Download available" Click="Download_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
