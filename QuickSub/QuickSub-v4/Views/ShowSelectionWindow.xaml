<Window x:Class="QuickSub.Views.ShowSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose the series"
        Icon="/QuickSub;component/Assets/QuickSub.ico"
        Width="860"
        Height="660"
        WindowStartupLocation="CenterOwner"
        FlowDirection="LeftToRight"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Choose the series" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="Click the poster that matches the folder."
                       Style="{StaticResource SecondaryText}"
                       Margin="0,5,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,20,0,20"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ShowsItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Tag="{Binding}"
                                Click="ShowButton_Click"
                                Style="{StaticResource SecondaryButton}"
                                Padding="8"
                                Width="180"
                                Height="310"
                                Margin="0,0,14,14">
                            <StackPanel>
                                <Border Width="150"
                                        Height="220"
                                        Background="{DynamicResource PanelBackgroundBrush}"
                                        CornerRadius="7"
                                        ClipToBounds="True">
                                    <Image Source="{Binding Image.Medium}" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock Text="{Binding Name}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="4,9,4,0" />
                                <TextBlock Text="{Binding StartYear}"
                                           Style="{StaticResource SecondaryText}"
                                           TextAlignment="Center"
                                           Margin="0,4,0,0" />
                                <TextBlock Text="{Binding SeasonText}"
                                           Style="{StaticResource SecondaryText}"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="2"
                Content="Cancel"
                Style="{StaticResource SecondaryButton}"
                HorizontalAlignment="Right"
                Click="Cancel_Click" />
    </Grid>
</Window>
