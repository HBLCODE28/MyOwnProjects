<Window x:Class="QuickSub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickSub"
        Icon="/QuickSub;component/Assets/QuickSub.ico"
        Width="920"
        Height="700"
        MinWidth="780"
        MinHeight="610"
        WindowStartupLocation="CenterScreen"
        FlowDirection="LeftToRight"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="QuickSub" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="TV subtitles, without the manual search."
                           Style="{StaticResource SecondaryText}"
                           FontSize="13"
                           Margin="0,3,0,0" />
            </StackPanel>

            <Button x:Name="SettingsButton"
                    Grid.Column="1"
                    Content="Settings"
                    Style="{StaticResource SecondaryButton}"
                    Click="SettingsButton_Click" />
        </Grid>

        <Border Grid.Row="1"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                AllowDrop="True"
                DragEnter="DropPanel_DragEnter"
                DragOver="DropPanel_DragOver"
                Drop="DropPanel_Drop">
            <Grid Margin="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="230"
                        Height="340"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource PanelSecondaryBrush}"
                        CornerRadius="10"
                        ClipToBounds="True">
                    <Grid>
                        <Image x:Name="PosterImage" Stretch="UniformToFill" Visibility="Collapsed" />
                        <StackPanel x:Name="DropPlaceholder"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Margin="20">
                            <TextBlock Text="Drop a series folder here"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="Season folders and mixed folder structures are supported."
                                       Style="{StaticResource SecondaryText}"
                                       FontSize="13"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="ShowNameText"
                               Text="No folder selected"
                               FontSize="27"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />

                    <TextBlock x:Name="ShowDetailsText"
                               Style="{StaticResource SecondaryText}"
                               FontSize="14"
                               Margin="0,7,0,0" />

                    <TextBlock x:Name="FolderPathText"
                               Style="{StaticResource SecondaryText}"
                               FontSize="12"
                               Margin="0,14,0,0"
                               TextWrapping="Wrap" />

                    <Border Background="{DynamicResource PanelSecondaryBrush}"
                            CornerRadius="9"
                            Padding="16"
                            Margin="0,22,0,0">
                        <StackPanel>
                            <TextBlock x:Name="StatusText"
                                       Text="Drag a folder to begin."
                                       FontSize="15"
                                       TextWrapping="Wrap" />
                            <ProgressBar x:Name="WorkProgress"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         Margin="0,14,0,0" />
                            <TextBlock x:Name="SummaryText"
                                       Style="{StaticResource SecondaryText}"
                                       FontSize="13"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <WrapPanel Margin="0,22,0,0">
                        <Button x:Name="ScanButton"
                                Content="Scan subtitles"
                                IsEnabled="False"
                                Click="ScanButton_Click"
                                Margin="0,0,10,10" />
                        <Button x:Name="ChangeSeriesButton"
                                Content="Change series"
                                Style="{StaticResource SecondaryButton}"
                                Visibility="Collapsed"
                                Click="ChangeSeriesButton_Click"
                                Margin="0,0,10,10" />
                        <Button x:Name="ViewDetailsButton"
                                Content="View details"
                                Style="{StaticResource SecondaryButton}"
                                Visibility="Collapsed"
                                Click="ViewDetailsButton_Click"
                                Margin="0,0,10,10" />
                        <Button x:Name="OpenFolderButton"
                                Content="Open folder"
                                Style="{StaticResource SecondaryButton}"
                                Visibility="Collapsed"
                                Click="OpenFolderButton_Click"
                                Margin="0,0,10,10" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Style="{StaticResource DangerButton}"
                                Visibility="Collapsed"
                                Click="CancelButton_Click"
                                Margin="0,0,10,10" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="Video names must include S01E01 or 1x01. Files without these patterns are skipped to prevent wrong downloads."
                   Style="{StaticResource SecondaryText}"
                   FontSize="12"
                   Margin="2,14,2,0"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
