<Window x:Class="QuickSub.Views.PartialResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Subtitles missing"
        Icon="/QuickSub;component/Assets/QuickSub.ico"
        Width="540"
        Height="330"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FlowDirection="LeftToRight"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="27">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Not all subtitles were found"
                       FontSize="23"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="ResultText"
                       FontSize="16"
                       Margin="0,15,0,0"
                       TextWrapping="Wrap" />
            <TextBlock Text="You can download the available subtitles or review the results first."
                       Style="{StaticResource SecondaryText}"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0" />
        </StackPanel>

        <WrapPanel Grid.Row="1" HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Style="{StaticResource SecondaryButton}"
                    Click="Cancel_Click"
                    Margin="0,0,10,0" />
            <Button Content="Review results"
                    Style="{StaticResource SecondaryButton}"
                    Click="Review_Click"
                    Margin="0,0,10,0" />
            <Button Content="Download available" Click="Download_Click" />
        </WrapPanel>
    </Grid>
</Window>
