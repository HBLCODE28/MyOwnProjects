<Window x:Class="QuickSub.Views.ReviewExistingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review existing subtitles"
        Icon="/QuickSub;component/Assets/QuickSub.ico"
        Width="700"
        Height="560"
        WindowStartupLocation="CenterOwner"
        FlowDirection="LeftToRight"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Select subtitles to replace" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Unchecked files will be kept."
                       Style="{StaticResource SecondaryText}"
                       Margin="0,5,0,0" />
        </StackPanel>

        <ListBox Grid.Row="1" ItemsSource="{Binding}" Margin="0,18,0,18">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding Replace}"
                              Margin="12,9">
                        <StackPanel>
                            <TextBlock Text="{Binding Video.FileName}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Video.ExistingSubtitlePath}"
                                       Style="{StaticResource SecondaryText}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Style="{StaticResource SecondaryButton}"
                    Click="Cancel_Click"
                    Margin="0,0,10,0" />
            <Button Content="Continue" Click="Continue_Click" />
        </StackPanel>
    </Grid>
</Window>
